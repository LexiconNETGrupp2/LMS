@using LMS.Shared.DTOs.AuthDtos
@inject IApiService ApiService

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h5 mb-3">Skapa användare</h2>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success" role="alert">@_successMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        <EditForm Model="_form" OnValidSubmit="HandleValidSubmitAsync">
            <DataAnnotationsValidator />

            <div class="g-3">
                <div class="mb-3">
                    <label for="firstName" class="form-label">Förnamn</label>
                    <InputText id="firstName" class="form-control" @bind-Value="_form.FirstName" placeholder="Förnamn" />
                    <ValidationMessage For="() => _form.FirstName" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="lastName" class="form-label">Efternamn</label>
                    <InputText id="lastName" class="form-control" @bind-Value="_form.LastName" placeholder="Efternamn" />
                    <ValidationMessage For="() => _form.LastName" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">E-post</label>
                    <InputText id="email" type="email" class="form-control" @bind-Value="_form.Email" placeholder="E-postadress" />
                    <ValidationMessage For="() => _form.Email" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Lösenord</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="_form.Password" placeholder="Lösenord" />
                    <ValidationMessage For="() => _form.Password" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="role" class="form-label">Roll</label>
                    <InputSelect id="role" class="form-select" @bind-Value="_form.Role">
                        <option value="@RolesNames.Student">Elev</option>
                        <option value="@RolesNames.Teacher">Lärare</option>
                    </InputSelect>
                    <ValidationMessage For="() => _form.Role" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="course" class="form-label">Kurs</label>
                    <InputSelect id="course" class="form-select" @bind-Value="_form.CourseId">
                        <option value="" disabled="@IsCourseRequired" selected>Välj kurs...</option>
                        @foreach (var (courseId, courseName) in CourseOptions)
                        {
                            <option value="@courseId">@courseName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _form.CourseId" class="text-danger" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Sparar..." : "Skapa användare")
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm" disabled="@_isSubmitting">
                    Rensa
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback<UserRegistrationDto> OnUserCreated { get; set; }
    [Parameter] public Dictionary<Guid, string> CourseOptions { get; set; } = new();

    private CreateUserFormModel _form = new();
    private bool _isSubmitting;
    private string? _successMessage;
    private string? _errorMessage;

    private bool IsCourseRequired => RolesNames.Student.Equals(_form.Role);

    private async Task HandleValidSubmitAsync()
    {
        _isSubmitting = true;
        _successMessage = null;
        _errorMessage = null;

        try
        {
            var dto = new UserRegistrationDto
            {
                FirstName = _form.FirstName.Trim(),
                LastName = _form.LastName.Trim(),
                Email = _form.Email.Trim(),
                UserName = _form.Email.Trim(),
                Role = _form.Role,
                Password = _form.Password,
                CourseId = _form.CourseId,
            };

            await ApiService.PostAsync<UserRegistrationDto, object?>("api/auth", dto);
            _successMessage = "Användaren skapades.";
            ResetForm();

            if (OnUserCreated.HasDelegate)
            {
                await OnUserCreated.InvokeAsync(dto);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Kunde inte skapa användaren: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _form = new CreateUserFormModel();
    }

    private sealed class CreateUserFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Förnamn krävs")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Efternamn krävs")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "E-post krävs")]
        [EmailAddress(ErrorMessage = "Ange en giltig e-postadress")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Lösenord krävs")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Roll är obligatorisk")]
        public string Role { get; set; } = RolesNames.Student;

        public Guid? CourseId { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (RolesNames.Student.Equals(Role) && CourseId is null)
            {
                yield return new ValidationResult("Välj en kurs för en elev.", [nameof(CourseId)]);
            }
        }
    }
}
