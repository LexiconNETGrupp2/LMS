@using LMS.Shared
@inject IApiService ApiService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<div class="container">
    <h1 class="h1 fs-3 fw-bold">Lärarens Dashboard</h1>
</div>

<TeacherOverview AllCourses="courses"
                 ActiveCourses="activeCourses"
                 SearchCourses="SearchForCourses" />

@code {
    private IReadOnlyCollection<CourseDto>? courses;
    private IReadOnlyCollection<CourseDto> activeCourses = [];
    private bool isLoading = false;
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Now);    

    protected async override Task OnInitializedAsync()
    {
        await Init();
    }

    private async Task Init()
    {
        // AFAIK this component can only load if the current user is a teacher + api also has validation
        
        var response = await ApiService.GetAsync<PagedResult<CourseDto>>($"api/courses?beforeDate={_today}");
        courses = response?.Items ?? [];
        await SetActiveCourses();
    }

    private async Task SetActiveCourses()
    {
        if (courses is null) return;

        activeCourses = courses.Where(c => c.StartDate <= _today && c.EndDate >= _today).ToList();
    }

    private async Task SearchForCourses(string search)
    {
        var response = await ApiService.GetAsync<PagedResult<CourseDto>>($"api/courses?search={search}");
        courses = response?.Items ?? [];
    }
}
