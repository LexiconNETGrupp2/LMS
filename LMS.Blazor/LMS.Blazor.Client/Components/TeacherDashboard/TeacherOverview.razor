<div class="container mt-5">
    <div class="row">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-6">
                    <div class="d-flex justify-content-between">
                        <h2 class="h2 fs-5 fw-semibold d-inline-block">Aktiva kurser</h2>
                        <a href="/courses">Visa alla ＞</a>
                    </div>
                    <div class="overflow-y-auto" style="height: 23em;">
                        <ActiveCourses Courses="ActiveCourses" />
                    </div>
                </div>
                <div class="col-lg-6">
                    <h2 class="h2 fs-5 fw-semibold">Senaste inlämningar</h2>
                    @* Komponent för att lista senaste aktiviteter *@
                    @* Detta är placeholder tills riktig *@
                    <ul class="list-group shadow-sm">
                        @foreach (var activity in _latestActivities) {
                            <li class="list-group-item d-flex">
                                <div class="d-flex justify-content-center align-items-center bg-primary text-light rounded-circle" 
                                        style="width: 2.9rem!important; aspect-ratio: 1/1 !important;">
                                    <i class="d-block fs-4 bi bi-file-earmark-text"></i>
                                </div>
                                <div class="ms-2">
                                    <div class="">@activity.StudentName lämnade in uppgift "@activity.AssignmentName"</div>
                                    <div class="text-secondary">@activity.TimeSinceUpload() sedan</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <h2 class="h2 fs-5 fw-semibold">Kommande aktiviteter</h2>
                    @* Komponent för att lista kommande aktiviteter *@
                    @* Detta är placeholder tills riktig *@
                    <ul class="list-group shadow-sm">
                        @foreach (var activity in _comingActivities) {
                            <li class="list-group-item d-flex justify-content-between">
                                <div class="d-flex flex-column w-25">
                                    <div><span class="badge rounded-pill text-bg-primary me-2">@activity.Type.Name</span>@activity.Name</div>
                                    <div class="text-secondary">Kurs: @activity.CourseName</div>
                                </div>
                                <div class="d-flex flex-column text-end w-25">
                                    <div><i class="bi bi-calendar me-1"></i>@activity.EndDateStr</div>
                                    <div class="text-secondary"><i class="bi bi-clock me-1"></i>@activity.EndTimeStr</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyCollection<CourseDto>? AllCourses { get; set; }

    [Parameter]
    public IReadOnlyCollection<CourseDto> ActiveCourses { get; set; } = [];

    [Parameter]
    public EventCallback<string> SearchCourses { get; set; }

    private List<ActivityViewModel> _comingActivities = [];
    private List<TurnInAssignmentViewModel> _latestActivities = [];

    protected override void OnInitialized()
    {
        InitComingActivities();
        InitLatestActivities();
    }

    private void InitComingActivities()
    {
        _comingActivities = [
            new() { Name = "Latin 101", EndDate = new DateTime(2026, 4, 20, 23, 59, 0), Type = new("Examination"), CourseName = "Id Optio" },
            new() { Name = "Animi Id", EndDate = new DateTime(2026, 4, 21, 10, 15, 0), Type = new("Föreläsning"), CourseName = "Et Inventore" },
            new() { Name = "Omnis Porro", EndDate = new DateTime(2026, 4, 21, 15, 15, 0), Type = new("Föreläsning"), CourseName = "Vel Et" },
            new() { Name = "Totam Sunt", EndDate = new DateTime(2026, 4, 23, 23, 59, 0), Type = new("E-learning"), CourseName = "Id Optio" },
    ];
    }

    private void InitLatestActivities()
    {
        _latestActivities = [
            new() { StudentName = "Christian Abrahamsson", AssignmentName = "Hack Alarm", UploadedAt = new DateTime(2026, 4, 14, 10, 14, 52) },
            new() { StudentName = "Alexander Ali", AssignmentName = "Hack Alarm", UploadedAt = new DateTime(2026, 4, 14, 9, 10, 40) },
            new() { StudentName = "Max Hassan", AssignmentName = "Hack Matrix", UploadedAt = new DateTime(2026, 4, 13, 23, 59, 50) },
            new() { StudentName = "Helena Wikström", AssignmentName = "Hack Alarm", UploadedAt = new DateTime(2026, 4, 12, 16, 14, 52) },
            new() { StudentName = "Charlotte Norberg", AssignmentName = "Hack Matrix", UploadedAt = new DateTime(2026, 4, 12, 12, 00, 23) },
    ];
    }

    private class ActivityViewModel
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public DateTime StartDate { get; set; }
        public string StartDateStr => StartDate.ToString("yyyy-MM-dd");
        public string StartTimeStr => StartDate.ToString("HH-mm");
        public DateTime EndDate { get; set; }
        public string EndDateStr => EndDate.ToString("yyyy-MM-dd");
        public string EndTimeStr => EndDate.ToString("HH-mm");
        public ActivityTypeDto Type { get; set; } = new(string.Empty);
        public Guid ModuleId { get; set; }
        public string CourseName { get; set; } = string.Empty;
    }

    private class TurnInAssignmentViewModel
    {
        public string StudentName { get; set; } = string.Empty;
        public string AssignmentName { get; set; } = string.Empty;
        public DateTime UploadedAt { get; set; }
        public string TimeSinceUpload()
        {
            string dayStr = "";
            string hourStr = "";
            string minuteStr = "";
            TimeSpan duration = DateTime.Now - UploadedAt;
            if (duration.Days > 0) dayStr += duration.Days == 1 ? $"{duration.Days} dag" : $"{duration.Days} dagar";
            if (duration.Hours > 0) hourStr += duration.Hours == 1 ? $"{duration.Hours} timme" : $"{duration.Hours} timmar";
            if (duration.Days == 0) minuteStr += duration.Minutes == 1 ? $"{duration.Minutes} minut" : $"{duration.Minutes} minuter";
            return String.Join(" ", dayStr, hourStr, minuteStr).Trim();
        }
    }
}
