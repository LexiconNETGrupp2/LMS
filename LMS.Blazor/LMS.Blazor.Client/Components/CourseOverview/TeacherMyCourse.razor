@code {
    [CascadingParameter]
    private Task<AuthenticationState> _authenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Get UserId
        var authState = await _authenticationStateTask;
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) {
            GoToDashboard();
            return;
        }

        // Get CourseId
        var uri = $"api/courses/user/{userId}";
        var result = await ApiService.GetAsync<CourseDto>(uri);
        if (result is null) {
            GoToDashboard();
            return;
        }

        NavigationManager.NavigateTo($"/courses/{result.Id}");
    }

    private void GoToDashboard()
        => NavigationManager.NavigateTo("/");
}
