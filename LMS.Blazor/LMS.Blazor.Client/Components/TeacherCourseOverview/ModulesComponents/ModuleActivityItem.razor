<div class="border rounded-4 p-3">
    <div class="d-flex justify-content-between align-items-start gap-3">
        <div class="min-w-0">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <span class="badge rounded-pill text-primary bg-primary-subtle">@Activity.Type</span>
                <span class="fw-semibold fs-5">@Activity.Title</span>
            </div>

            <div class="text-secondary mb-3">
                <i class="bi bi-calendar3 me-1"></i>
                @Activity.Date.ToString("yyyy-MM-dd")

                @if (Activity.Deadline is not null)
                {
                    <span class="ms-2 text-warning-emphasis">
                        <i class="bi bi-clock me-1"></i>
                        Deadline: @Activity.Deadline.Value.ToString("yyyy-MM-dd")
                    </span>
                }
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            @if (Activity.ShowSubmissionButton)
            {
                <button class="btn btn-success-subtle text-success rounded-3"
                        @onclick="() => OnViewSubmissions.InvokeAsync(Activity)">
                    <i class="bi bi-eye me-2"></i>
                    Se inlämningar
                </button>
            }

            <button class="btn btn-link text-primary p-0" @onclick="() => OnEdit.InvokeAsync(Activity)">
                <i class="bi bi-pencil-square fs-5"></i>
            </button>

            <button class="btn btn-link text-danger p-0" @onclick="() => OnDelete.InvokeAsync(Activity)">
                <i class="bi bi-trash fs-5"></i>
            </button>
        </div>
    </div>

    <hr />

    <div class="small text-secondary fw-semibold mb-2">Dokument</div>

    @if (Activity.Documents.Any())
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var document in Activity.Documents)
            {
                <ModuleDocumentItem Document="document" />
            }
        </div>
    }

    <button class="btn btn-link text-decoration-none px-0 mt-2"
            @onclick="() => OnAddDocument.InvokeAsync(Activity)">
        <i class="bi bi-plus-circle me-1"></i>
        Lägg till dokument
    </button>
</div>

@code {
    [Parameter, EditorRequired] public ModuleActivityModel Activity { get; set; } = new();
    [Parameter] public EventCallback<ModuleActivityModel> OnEdit { get; set; }
    [Parameter] public EventCallback<ModuleActivityModel> OnDelete { get; set; }
    [Parameter] public EventCallback<ModuleActivityModel> OnViewSubmissions { get; set; }
    [Parameter] public EventCallback<ModuleActivityModel> OnAddDocument { get; set; }
}
