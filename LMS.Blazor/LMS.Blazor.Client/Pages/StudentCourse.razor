@page "/StudentCourse/{StudentId:guid}"
@using System.Net
@using LMS.Blazor.Client.Components.CourseOverview
@using LMS.Shared.DTOs.UserDtos
@inject IApiService ApiService
@attribute [Authorize(Roles = RolesNames.Teacher)]

@if (_isLoading)
{
    <div class="container py-4">
        <div class="alert alert-secondary mb-0" role="status">Laddar elevinformation...</div>
    </div>
}
else if (_student is null)
{
    <div class="container py-4">
        <div class="alert alert-warning mb-0">Kunde inte hitta elev.</div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header">
                <h2 class="h2 fw-semibold mb-0">Elevöversikt</h2>
            </div>
            <div class="card-body p-0">
                <dl class="row g-0 mb-0">
                    <dt class="col-sm-4 border-bottom p-3 fw-semibold">Förnamn</dt>
                    <dd class="col-sm-8 border-bottom p-3 text-muted mb-0">@_student.FirstName</dd>
                    <dt class="col-sm-4 border-bottom p-3 fw-semibold">Efternamn</dt>
                    <dd class="col-sm-8 border-bottom p-3 text-muted mb-0">@_student.LastName</dd>
                    <dt class="col-sm-4 border-bottom p-3 fw-semibold">E-postadress</dt>
                    <dd class="col-sm-8 border-bottom p-3 text-muted mb-0">@_student.Email</dd>
                    <dt class="col-sm-4 border-bottom p-3 fw-semibold">Roll</dt>
                    <dd class="col-sm-8 border-bottom p-3 text-muted mb-0">@_student.Role</dd>
                </dl>
            </div>
        </div>
    </div>

    if (_courseOverview is not null)
    {
        <CourseOverviewView Course="_courseOverview" />
    }
    else
    {
        <div class="container pb-4">
            <div class="alert alert-info mb-0">Ingen kurs är kopplad till användaren.</div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid StudentId { get; set; }

    private UserDto? _student;
    private CourseOverviewViewModel? _courseOverview;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _student = await ApiService.GetAsync<UserDto>($"api/users/{StudentId}");

            if (_student?.CourseId is { } courseId)
            {
                var course = await ApiService.GetAsync<CourseDto>($"api/courses/{courseId}");
                if (course is not null)
                {
                    _courseOverview = CourseOverviewMapper.Map(course);
                }
            }
        }
        catch (HttpRequestException e) when (e.StatusCode is HttpStatusCode.NotFound)
        {
            Console.WriteLine($"Could not load. {e.Message}");
        }
        finally
        {
            _isLoading = false;
        }

    }
}
