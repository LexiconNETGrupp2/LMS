@page "/Users"
@using LMS.Blazor.Client.Components.User
@using LMS.Shared.DTOs.AuthDtos
@using LMS.Shared.DTOs.UserDtos
@using LMS.Shared.Pagination
@inject IApiService ApiService
@attribute [Authorize(Roles = RolesNames.Teacher)]

<PageTitle>Användare</PageTitle>

<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="fw-bold fs-3 mb-1">Användare</h1>
            <div class="text-secondary">Totalt <strong>@FilteredUsers.Count()</strong> användare i systemet</div>
        </div>
        <button class="btn btn-primary" @onclick="ToggleCreateForm">
            @if (!showCreateForm) {
                <i class="bi bi-plus"></i>
                @:Lägg till användare
            } else {
                <i class="bi bi-x-lg"></i>
                @:Stäng
            }
        </button>
    </div>
</div>

@if (showCreateForm) {
    <CreateUser OnUserCreated="OnUserCreated" CourseOptions="CourseOptions" />
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="flex-grow-1">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control border-start-0" placeholder="Sök efter namn eller e-post..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(searchTerm)) {
                <button type="button" class="btn btn-outline-secondary border-start-0" style="z-index:2;"
                        @onclick="ClearSearch" tabindex="-1">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>
    </div>
    <div class="btn-group ms-2" role="group">
        <button type="button" class="btn btn-outline-primary @(roleFilter == null ? "active" : "")"
                @onclick="() => SetRoleFilter(null)">
            Alla
        </button>
        <button type="button" class="btn btn-outline-primary @(roleFilter == RolesNames.Student ? "active" : "")"
                @onclick="() => SetRoleFilter(RolesNames.Student)">
            Elever
        </button>
        <button type="button" class="btn btn-outline-primary @(roleFilter == RolesNames.Teacher ? "active" : "")"
                @onclick="() => SetRoleFilter(RolesNames.Teacher)">
            Lärare
        </button>
    </div>
</div>

@if (pageErrors.Any()) {
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in pageErrors) {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="card shadow-sm border-0 p-2">
    <QuickGrid Class="table table-hover align-middle" ItemKey="u => u.Id" ItemsProvider="userProvider" Pagination="pagination">
        <PropertyColumn Property="@(u => u.FullName)"
                        Title="Namn"
                        Sortable="true"
                        IsDefaultSortColumn="true"
                        Align="Align.Start" />
        <PropertyColumn Property="@(u => u.Email)" Title="E-post" Sortable="true" Align="Align.Start" />
        <TemplateColumn Title="Roll" Align="Align.Start">
            <div class="badge rounded-pill bg-success-subtle text-success">
                @RoleName(context.Role)
            </div>
        </TemplateColumn>
        <PropertyColumn Property="@(u => CourseName(u.CourseId))" Title="Kurs" Sortable="true" Align="Align.Start" />
        <TemplateColumn Context="user" Title="Åtgärder" Align="Align.End">
            <button class="btn btn-link text-primary p-0">
                Redigera
            </button>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="@pagination" />
</div>

@code {
    private List<UserModel> _users = [];
    private readonly PaginationState pagination = new PaginationState { ItemsPerPage = 20 };
    private IReadOnlyList<CourseDto> Courses { get; set; } = [];
    private readonly List<string> pageErrors = [];
    private string searchTerm = string.Empty;
    private string? roleFilter = null;
    private Dictionary<Guid, string> CourseOptions => Courses.ToDictionary(c => c.Id, c => c.Name);
    private bool showCreateForm = false;

    private GridItemsProvider<UserModel>? userProvider;

    public class UserModel
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        [Required(ErrorMessage = "Förnamn krävs")]
        public string FirstName { get; set; } = string.Empty;
        [Required(ErrorMessage = "Efternamn krävs")]
        public string LastName { get; set; } = string.Empty;
        public string FullName => $"{FirstName} {LastName}";
        [Required(ErrorMessage = "E-postadress krävs")]
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = RolesNames.Student;
        [Required(ErrorMessage = "Kurs krävs")]
        public Guid? CourseId { get; set; }
    }

    private IQueryable<UserModel> FilteredUsers => _users
        .Where(u => roleFilter == null || u.Role == roleFilter)
        .Where(u => u.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .AsQueryable();


    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
        await LoadUsers();
    }

    private async Task LoadCourses()
    {
        try {
            var response = await ApiService.GetAsync<PagedResult<CourseDto>>("api/courses");
            Courses = response?.Items ?? [];
        } catch {
            pageErrors.Add("Kunde inte ladda kurser");
        }
    }

    private async Task LoadUsers()
    {
        userProvider = async request =>
        {
            PagedResult<UserDto>? response;
            try {
                response = await ApiService.GetAsync<PagedResult<UserDto>>(
                    $"api/users?page={pagination.CurrentPageIndex + 1}&pageSize={pagination.ItemsPerPage}"
                );
                if (response is null) return FailedToLoadUsers();
            } catch {
                return FailedToLoadUsers();
            }
            var models = response?.Items.Select(i => new UserModel {
                Id = Guid.Parse(i.Id),
                FirstName = i.FirstName,
                LastName = i.LastName,
                Email = i.Email,
                Role = i.Role ?? string.Empty,
                CourseId = i.CourseId
            }).ToList() ?? [];
            return GridItemsProviderResult.From(items: models, totalItemCount: response!.TotalItems);
        };
    }

    private GridItemsProviderResult<UserModel> FailedToLoadUsers()
    {
        pageErrors.Add("Kunde inte ladda användare");
        return GridItemsProviderResult.From<UserModel>([], 0);
    }

    private string CourseName(Guid? courseId) =>
        Courses.SingleOrDefault(s => s.Id == courseId)?.Name ?? string.Empty;

    private string RoleName(string role) =>
        role switch {
            RolesNames.Student => "Elev",
            RolesNames.Teacher => "Lärare",
            _ => role
        };


    private void SetRoleFilter(string? role)
    {
        roleFilter = role;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
    }

    private void OnUserCreated(UserDto user)
    {
        _users.Add(new UserModel {
            Id = Guid.Parse(user.Id),
            FirstName = user.FirstName,
            LastName = user.LastName,
            Email = user.Email,
            Role = user.Role ?? string.Empty,
            CourseId = user.CourseId,
        });
    }
}
