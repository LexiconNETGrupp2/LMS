@page "/courses"
@using LMS.Blazor.Client.Components.Pagination
@using LMS.Shared.Pagination
@attribute [Authorize(Roles = "Teacher")]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IApiService ApiService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Kurser</PageTitle>

<div class="modules-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="modules-page-title mb-1">Kurser</h1>
            <p class="text-secondary mb-0">Totalt @totalCourses kurser i systemet.</p>
        </div>
        <button type="button" class="btn btn-primary modules-primary-action" @onclick="() => GoToCreateCourses()">
            <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
            Lägg till Kurs
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <div class="alert alert-success">@actionMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="alert alert-danger">@loadError</div>
    }

    <div class="d-flex justify-content-between align-items-end mb-3">
        <Pagination CurrentPage="@Page" LastPage="@lastPage" />
        <div class="d-flex flex-column gap-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search me-1"></i>
                </span>
                <input type="search"
                       class="form-control small-placeholder border-start-0"
                       placeholder="Sök efter titel eller beskrivning..."
                       @bind:after="PerformSearch"
                       @bind="Search" />
                <button @onclick="PerformSearch" class="btn btn-outline-primary border-start-0" style="z-index: 2">
                    Sök
                </button>
            </div>
            <div class="btn-group d-flex" role="group">
                <button type="button" class="@GetFilterButtonClass(null)"
                        @onclick="() => SetCourseFilter(null)">
                    Alla
                </button>
                <button type="button" class="@GetFilterButtonClass(ActiveFilter)"
                        @onclick="() => SetCourseFilter(ActiveFilter)">
                    Aktiva
                </button>
                <button type="button" class="@GetFilterButtonClass(PastFilter)"
                        @onclick="() => SetCourseFilter(PastFilter)">
                    Avslutade
                </button>
                <button type="button" class="@GetFilterButtonClass(FutureFilter)"
                        @onclick="() => SetCourseFilter(FutureFilter)">
                    Kommande
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="modules-loading card shadow-sm">
            <div class="card-body d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span>Laddar kurser och moduler...</span>
            </div>
        </div>
    }
    @if (courses.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="mb-0 text-body-secondary">Det finns inga kurser ännu. Skapa en kurs först och lägg sedan till moduler.</p>
            </div>
        </div>
    }
    else
    {
        <section class="card shadow-sm modules-card mb-3">
            <div class="modules-accordion">
                @foreach (var course in courses)
                {
                    var isExpanded = expandedCourseIds.Contains(course.Id);

                    <section class="modules-course-section">

                        <div class="d-flex justify-content-between gap-3 w-100 p-2">
                            <div class="display-inline-block w-50">
                                <span class="">
                                    <i class="bi bi-layers modules-course-icon" aria-hidden="true"></i>
                                    <span class="fw-semibold text-dark">
                                        <button class="btn btn-link px-0" @onclick="() => GoToCourseOverview(course.Id)">
                                            @course.Name
                                        </button>
                                    </span>
                                </span>
                                <span class="modules-chip">@course.Modules.Count moduler</span>
                                <span class="modules-chip">@course.TotalParticipants deltagare</span>
                                <div class="py-1 ms-2">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <span>@course.StartDateStr - @course.EndDateStr</span>
                                </div>
                            </div>

                            <div class="display-inline-block w-50 d-flex justify-content-end">
                                <button type="button"
                                        class="btn btn-link text-decoration-none text-secondary-emphasis ps-lg-5"
                                        @onclick="() => ToggleCourse(course.Id)">
                                    <span class="modules-course-chevron">
                                        <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                                        @(isExpanded ? "Dölj" : "Visa") moduler
                                    </span>
                                </button>

                                <button type="button"
                                        class="btn btn-link text-primary modules-icon-button"
                                        title="Redigera kurs"
                                        @onclick="() => UpdateCourse(course.Id)">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    Redigera kurs
                                </button>

                                <button type="button"
                                        class="btn btn-link text-danger modules-icon-button"
                                        title="Ta bort kurs"
                                        @onclick="() => DeleteCourse(course)">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                    Radera kurs
                                </button>
                            </div>

                        </div>
                        @if (isExpanded)
                        {
                            <div class="modules-course-content pt-3">
                                <div class="table-responsive modules-table-wrap">
                                    <table class="table align-middle mb-0">
                                        <thead>
                                        <tr>
                                            <th>Modulnamn</th>
                                            <th>Period</th>
                                            <th>Aktiviteter</th>
                                            <th class="text-end">Åtgärder</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var module in course.Modules.OrderBy(m => m.StartDate).ThenBy(m => m.Name))
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold text-dark">@module.Name</div>
                                                </td>
                                                <td>
                                                    <div class="modules-period">
                                                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                                                        <span>@module.StartDateStr - @module.EndDateStr</span>
                                                    </div>
                                                </td>
                                                <td>@module.ActivitiesCount</td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-link text-primary modules-icon-button"
                                                            title="Redigera modul"
                                                            @onclick="() => OpenEditModal(course, module)">
                                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-link text-danger modules-icon-button"
                                                            title="Ta bort modul"
                                                            @onclick="() => DeleteModuleAsync(course, module)">
                                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                            <td colspan="4" class="modules-inline-add-cell">
                                                <button type="button"
                                                        class="btn btn-link modules-inline-add"
                                                        @onclick="() => OpenCreateModal(course.Id)">
                                                    <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                                                    Lägg till modul i @course.Name
                                                </button>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </section>
                }
            </div>
        </section>
        <Pagination CurrentPage="@Page" LastPage="@lastPage" />
    }
</div>

<AddModuleModal IsOpen="@isModalOpen"
                LockCourseSelection="@lockCourseSelection"
                IsSubmitting="@isSubmitting"
                ErrorMessage="@submitError"
                Courses="@courses"
                Model="@moduleForm"
                OnClose="CloseModal"
                OnSubmit="SaveModuleAsync" />

@code {
    private const string ActiveFilter = "active";
    private const string PastFilter = "past";
    private const string FutureFilter = "future";

    private List<CourseDto> courses = [];
    private HashSet<Guid> expandedCourseIds = [];
    private ModuleFormModel moduleForm = new();
    private bool isLoading = true;
    private bool isModalOpen;
    private bool isSubmitting;
    private bool lockCourseSelection;
    private int lastPage = PagedQuery.MinPage;
    private const int DefaultPageSize = 20;
    private string? loadError;
    private string? submitError;
    private string? actionMessage;
    private int totalCourses;

    [SupplyParameterFromQuery] public int Page { get; set; } = PagedQuery.MinPage;
    [SupplyParameterFromQuery] public DateOnly? AfterDate { get; set; }
    [SupplyParameterFromQuery] public DateOnly? BeforeDate { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await LoadCoursesAsync();
    }

    private async Task LoadCoursesAsync()
    {
        var expandedBeforeReload = expandedCourseIds.ToHashSet();

        isLoading = true;
        loadError = null;

        try
        {
            Page = Math.Max(Page, PagedQuery.MinPage);

            var uri = $"api/courses?page={Page}&pageSize={DefaultPageSize}";
            if (!string.IsNullOrWhiteSpace(Search)) uri += $"&search={Uri.EscapeDataString(Search)}";
            if (AfterDate.HasValue) uri += $"&afterDate={AfterDate:yyyy-MM-dd}";
            if (BeforeDate.HasValue) uri += $"&beforeDate={BeforeDate:yyyy-MM-dd}";
            var result = await ApiService.GetAsync<PagedResult<CourseDto>>(uri);
            courses = result?.Items.ToList() ?? [];
            lastPage = result?.TotalPages ?? PagedQuery.MinPage;
            totalCourses = result?.TotalItems ?? 0;

            expandedCourseIds = courses
                .Select(course => course.Id)
                .Where(expandedBeforeReload.Contains)
                .ToHashSet();

        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsSelectedFilter(string? filter) => filter switch
    {
        null => !AfterDate.HasValue && !BeforeDate.HasValue,
        ActiveFilter => AfterDate == DateOnly.FromDateTime(DateTime.Today) && BeforeDate == DateOnly.FromDateTime(DateTime.Today),
        PastFilter => !AfterDate.HasValue && BeforeDate == DateOnly.FromDateTime(DateTime.Today).AddDays(-1),
        FutureFilter => AfterDate == DateOnly.FromDateTime(DateTime.Today).AddDays(1) && !BeforeDate.HasValue,
        _ => false
    };

    private string GetFilterButtonClass(string? filter)
        => $"btn btn-outline-primary {(IsSelectedFilter(filter) ? "active" : string.Empty)}";

    private void SetCourseFilter(string? filter)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        AfterDate = null;
        BeforeDate = null;

        switch (filter)
        {
            case ActiveFilter:
                AfterDate = today;
                BeforeDate = today;
                break;
            case PastFilter:
                BeforeDate = today.AddDays(-1);
                break;
            case FutureFilter:
                AfterDate = today.AddDays(1);
                break;
        }

        PerformSearch();
    }

    private void PerformSearch()
    {
        Page = PagedQuery.MinPage;

        var uri = $"/courses?page={Page}";
        if (!string.IsNullOrWhiteSpace(Search)) uri += $"&search={Uri.EscapeDataString(Search)}";
        if (AfterDate.HasValue) uri += $"&afterDate={AfterDate:yyyy-MM-dd}";
        if (BeforeDate.HasValue) uri += $"&beforeDate={BeforeDate:yyyy-MM-dd}";

        NavigationManager.NavigateTo(uri);
    }

    private void ToggleCourse(Guid courseId)
    {
        if (!expandedCourseIds.Add(courseId))
        {
            expandedCourseIds.Remove(courseId);
        }
    }

    private void OpenCreateModal(Guid? courseId = null)
    {
        actionMessage = null;
        submitError = null;
        lockCourseSelection = courseId.HasValue;
        isModalOpen = true;

        var course = courses.FirstOrDefault(c => c.Id == courseId);

        moduleForm = new ModuleFormModel
        {
            CourseId = courseId,
            StartDate = course?.StartDate,
            EndDate = course?.StartDate
        };
    }

    private void OpenEditModal(CourseDto course, CourseModuleDto module)
    {
        actionMessage = null;
        submitError = null;
        lockCourseSelection = true;
        isModalOpen = true;

        moduleForm = new ModuleFormModel
        {
            ModuleId = module.Id,
            CourseId = course.Id,
            Name = module.Name,
            Description = module.Description,
            StartDate = module.StartDate,
            EndDate = module.EndDate
        };
    }

    private Task CloseModal()
    {
        if (!isSubmitting)
        {
            isModalOpen = false;
            submitError = null;
        }

        return Task.CompletedTask;
    }

    private async Task SaveModuleAsync()
    {
        actionMessage = null;
        submitError = null;

        if (!moduleForm.CourseId.HasValue || !moduleForm.StartDate.HasValue || !moduleForm.EndDate.HasValue)
        {
            submitError = "Fyll i kurs och datum innan du sparar.";
            return;
        }

        var selectedCourse = courses.FirstOrDefault(course => course.Id == moduleForm.CourseId.Value);
        if (selectedCourse is null)
        {
            submitError = "Det gick inte att hitta vald kurs.";
            return;
        }

        if (moduleForm.StartDate.Value > moduleForm.EndDate.Value)
        {
            submitError = "Startdatum kan inte vara senare än slutdatum.";
            return;
        }

        if (moduleForm.StartDate.Value < selectedCourse.StartDate || moduleForm.EndDate.Value > selectedCourse.EndDate)
        {
            submitError = $"Modulens datum måste ligga inom kursens period ({selectedCourse.StartDateStr} - {selectedCourse.EndDateStr}).";
            return;
        }

        isSubmitting = true;

        try
        {
            if (moduleForm.IsEditMode && moduleForm.ModuleId.HasValue)
            {
                var updateDto = new UpdateModuleDto(
                    moduleForm.Name.Trim(),
                    moduleForm.Description.Trim(),
                    moduleForm.StartDate.Value,
                    moduleForm.EndDate.Value);

                await ApiService.PutAsync($"api/modules/{moduleForm.ModuleId.Value}", updateDto);
                actionMessage = $"Modulen \"{moduleForm.Name}\" uppdaterades.";
            }
            else
            {
                var createDto = new CreateModuleDto(
                    moduleForm.Name.Trim(),
                    moduleForm.Description.Trim(),
                    moduleForm.StartDate.Value,
                    moduleForm.EndDate.Value,
                    moduleForm.CourseId.Value);

                await ApiService.PostAsync<CreateModuleDto, ModuleDto>("api/modules", createDto);
                actionMessage = $"Modulen \"{moduleForm.Name}\" lades till i kursen {selectedCourse.Name}.";
            }

            expandedCourseIds.Add(moduleForm.CourseId.Value);
            isModalOpen = false;
            await LoadCoursesAsync();
        }
        catch (HttpRequestException ex)
        {
            submitError = ex.Message;
        }
        catch (Exception)
        {
            submitError = "Ett oväntat fel inträffade när modulen skulle sparas.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteModuleAsync(CourseDto course, CourseModuleDto module)
    {
        actionMessage = null;
        submitError = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Vill du ta bort modulen \"{module.Name}\" från {course.Name}?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await ApiService.DeleteAsync($"api/modules/{module.Id}");
            expandedCourseIds.Add(course.Id);
            actionMessage = $"Modulen \"{module.Name}\" togs bort.";
            await LoadCoursesAsync();
        }
        catch (HttpRequestException ex)
        {
            loadError = ex.Message;
        }
        catch (Exception)
        {
            loadError = "Ett oväntat fel inträffade när modulen skulle tas bort.";
        }
    }

    private void GoToCreateCourses() => NavigationManager.NavigateTo("/create-course");
    private void GoToCourseOverview(Guid courseId) => NavigationManager.NavigateTo($"/courses/{courseId}");

    private void UpdateCourse(Guid courseId) => NavigationManager.NavigateTo($"/create-course/{courseId}");

    private async Task DeleteCourse(CourseDto course)
    {
        actionMessage = null;
        submitError = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Vill du ta bort kursen \"{course.Name}\"?");

        if (!confirmed) {
            return;
        }

        try {
            await ApiService.DeleteAsync($"api/courses/{course.Id}");
            actionMessage = $"Kursen \"{course.Name}\" togs bort.";
            await LoadCoursesAsync();
        } catch (HttpRequestException ex) {
            loadError = ex.Message;
        } catch (Exception) {
            loadError = "Ett oväntat fel inträffade när kursen skulle tas bort.";
        }
    }
}
