@page "/create-course/{CourseId:guid?}"
@inject IApiService ApiService
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = RolesNames.Teacher)]

@if (!_isEdit) {
    <PageTitle>Skapa Kurs</PageTitle>
} else {
    <PageTitle>Redigera Kurs</PageTitle>
}

@if (_successMessage is not null) {
    <div class="container">
        <div class="alert alert-success alert-dismissible" role="alert">
            <div>@_successMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (_errorMessage is not null) {
    <div class="container">
        <div class="alert alert-danger alert-dismissible" role="alert">
            <span>@_errorMessage</span>
            @if (_includeReloadButton) {
                <button type="button" 
                        class="btn btn-link" 
                        @onclick="() => NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true)">
                        Ladda om
                </button>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<CreateCourseForm Course="_course"
                  IsEditing="_isEdit"
                  OnAddModule="AddModule"
                  OnRemoveModule="RemoveModule"
                  OnCreateCourse="SubmitCourse"
                  IsLoading="_isLoading"
                  OverlapErrors="_overlapErrors"
                  EarliestStartDate="@_earliestStart"
                  LatestEndDate="@_latestEnd" />

@code {
    [Parameter] public Guid? CourseId { get; set; }
    private bool _isEdit = false;
    private CourseFormModel _course = new();
    private List<string> _overlapErrors = [];
    private bool _isLoading = false;
    private string? _successMessage;
    private string? _errorMessage;
    private bool _includeReloadButton = false;

    private string? _earliestStart = null;
    private string? _latestEnd = null;

    protected async override Task OnInitializedAsync()
    {
        if (CourseId is null) {
            InitCourse();
        } else {
            await GetCourse();
        }
    }

    private void InitCourse()
    {
        _course = new() { Id = Guid.NewGuid() };
        AddModule();
        _isEdit = false;
    }

    private async Task GetCourse()
    {
        if (CourseId is null) {
            InitCourse();
            return;
        }

        CourseDto? courseDto = await ApiService.GetAsync<CourseDto>($"api/courses/{CourseId}");
        if (courseDto is null) {
            InitCourse();
            return;
        }

        if (courseDto.Modules.Count > 0) {
            _earliestStart = courseDto.Modules.OrderBy(m => m.StartDate).First().StartDateStr;
            _latestEnd = courseDto.Modules.OrderBy(m => m.StartDate).Last().EndDateStr;
        }

        _course = new() {
            Id = courseDto.Id,
            Name = courseDto.Name,
            Description = courseDto.Description,
            StartDate = courseDto.StartDate,
            EndDate = courseDto.EndDate,
            Modules = []
        };
        _isEdit = true;
    }

    private void AddModule()
    {
        _course.Modules.Add(new() {
            ModuleId = Guid.NewGuid(),
            CourseId = _course.Id
        });
    }

    private void RemoveModule(Guid? id)
    {
        if (id is null) return;
        var module = _course.Modules.FirstOrDefault(module => module.ModuleId == id);
        if (module is null) return;
        _course.Modules.Remove(module);
    }

    private async Task SubmitCourse()
    {
        _successMessage = null;
        _errorMessage = null;

        if (_course.Modules.Count > 0) {
            CheckForOverlap();
            if (_overlapErrors.Count > 0) return;
        }

        _isLoading = true;

        try {
            if (_isEdit) {
                await UpdateCourse();
                _successMessage = "Kursen har uppdaterats!";
            } else {
                CourseId = await CreateNewCourse();
                _successMessage = "Kursen har skapats!";
            }
        }
        catch (Exception e) {
            if (e.Message == "405 MethodNotAllowed") {
                _errorMessage = "Ett fel har uppstått. Snälla ladda om sidan och försök igen.";
                _includeReloadButton = true;
            } else {
                _errorMessage = e.Message;
                _includeReloadButton = false;
            }
        } finally {
            _isLoading = false;
        }
    }

    private async Task<Guid> CreateNewCourse()
    {
        CreateCourseDto createCourseDto = new() {
            Name = _course.Name,
            Description = _course.Description,
            StartDate = (DateOnly)_course.StartDate!,
            EndDate = (DateOnly)_course.EndDate!,
            Modules = _course.Modules.Select(m => new CreateModuleDto(
                Name: m.Name,
                Description: m.Description,
                StartDate: (DateOnly)m.StartDate!,
                EndDate: (DateOnly)m.EndDate!,
                CourseId: (Guid)m.CourseId!
            )).ToList()
        };
        var result = await ApiService.PostAsync<CreateCourseDto, CourseDto>("api/courses", createCourseDto);
        return result!.Id;
    }

    private async Task UpdateCourse()
    {
        UpdateCourseDto updateCourseDto = new(
            Name: _course.Name,
            Description: _course.Description,
            StartDate: (DateOnly)_course.StartDate!,
            EndDate: (DateOnly)_course.EndDate!
        );
        await ApiService.PatchAsync<UpdateCourseDto, bool>($"api/courses/{CourseId}", updateCourseDto);
    }

    private void CheckForOverlap()
    {
        _overlapErrors = [];
        int i = 0;
        if (_course.StartDate > _course.Modules[i].StartDate) {
            _overlapErrors.Add($"Modul {_course.Modules[i].Name} startar innan kursen");
        }
        for (i = 1; i < _course.Modules.Count; i++) {
            if (_course.Modules[i - 1].EndDate >= _course.Modules[i].StartDate) {
                _overlapErrors.Add($"Modul {_course.Modules[i].Name} börjar innan {_course.Modules[i - 1].Name} slutar");
            }
        }
        i = Math.Max(i - 1, 0);
        if (_course.EndDate < _course.Modules[i].EndDate) {
            _overlapErrors.Add($"Modul {_course.Modules[i].Name} slutar efter kursen");
        }
    }
}
